# Copy to .env and fill in. Never commit .env.

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Transcription (runs locally). "small" on CPU is the safe default for a 2 GB GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# translate = always output English (use for Hindi/Hinglish lectures); transcribe = keep original language
WHISPER_TASK=translate

# If YouTube answers "Sign in to confirm you're not a bot", set this to your browser
# (chrome, edge, firefox) so yt-dlp downloads with your logged-in session.
YTDLP_COOKIES_FROM_BROWSER=

# Leave QDRANT_URL empty to use an embedded on-disk Qdrant under DATA_DIR (no Docker needed).
# Set it (plus QDRANT_API_KEY) for Qdrant Cloud when deploying.
QDRANT_URL=
QDRANT_API_KEY=

# Empty = SQLite file under DATA_DIR. Set a Postgres URL when deploying.
DATABASE_URL=

DATA_DIR=data
CORS_ORIGINS=http://localhost:3000
TOP_K=6

# Retrieval
RETRIEVAL_MODE=hybrid          # dense | bm25 | hybrid
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2    # scores the top hits for the refusal gate (order unchanged); empty = off
RERANK_THRESHOLD=0.01          # refuse when the best rerank score (0..1) is below this; tune with eval/run.py
CLASSIFY_SEGMENTS=true         # label segments teaching/off_topic/admin/exam_hint (one LLM call per ~20 segments)
